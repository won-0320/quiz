# Supabase 프로젝트 설정 (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 주의: 반드시 legacy anon 키(eyJ... 로 시작하는 JWT)를 쓴다.
# 학생은 로그인하지 않은 채 grade-short-answers 함수를 호출하는데,
# 이 함수가 verify_jwt=true 로 배포돼 있어 JWT 형식이 아닌 새 publishable 키
# (sb_publishable_...) 는 통과하지 못한다.
# 새 키를 쓰려면 grade-short-answers 를 verify_jwt=false 로 배포해야 한다.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
